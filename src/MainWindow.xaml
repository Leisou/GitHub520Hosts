<Window x:Class="GitHub520Hosts.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="GitHub520 Hosts"
        Icon="pack://application:,,,/app.ico"
        Width="480" Height="660" MinWidth="480" MaxWidth="480" MinHeight="660" MaxHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="NoResize"
        Background="#F3F3F3"
        FontFamily="Microsoft YaHei UI, Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#F3F3F3"/>
        <SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Stroke" Color="#E6E6E6"/>
        <SolidColorBrush x:Key="Line" Color="#F0F0F0"/>
        <SolidColorBrush x:Key="Text" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="SubText" Color="#5C5C5C"/>
        <SolidColorBrush x:Key="Muted" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="Accent" Color="#0F6CBD"/>
        <SolidColorBrush x:Key="Ok" Color="#0F7B0F"/>
        <SolidColorBrush x:Key="Err" Color="#C42B1C"/>
        <SolidColorBrush x:Key="Warn" Color="#9D5D00"/>

        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>

        <!-- 整行可点击的操作按钮 -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="6,5">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F3F3F3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.42"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标题栏按钮 -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E8E8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="6,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDEDED"/>
                                <Setter Property="Foreground" Value="{StaticResource SubText}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 日志条目 -->
        <DataTemplate x:Key="LogTemplate">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Time}" Foreground="#B8B8B8" FontSize="11"
                           FontFamily="Cascadia Mono, Consolas" Margin="0,1,9,0" />
                <TextBlock Grid.Column="1" Text="{Binding Message}" Foreground="{Binding Foreground}"
                           FontSize="12" TextWrapping="Wrap" LineHeight="19" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ================= 标题栏 ================= -->
        <Grid Grid.Row="0">
            <TextBlock Text="GitHub520 Hosts" FontSize="12" Foreground="{StaticResource Muted}"
                       VerticalAlignment="Center" Margin="18,0,0,0" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Margin="0,0,6,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick" ToolTip="最小化">
                    <Path Data="M4,9 H16" Stroke="#3A3A3A" StrokeThickness="1.1" Width="20" Height="18" Stretch="None" />
                </Button>
                <Button Style="{StaticResource CloseButton}" Click="OnCloseClick" ToolTip="关闭">
                    <Path Data="M5,4 L15,14 M15,4 L5,14" Stroke="#3A3A3A" StrokeThickness="1.1" Width="20" Height="18" Stretch="None" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ================= 内容 ================= -->
        <Grid Grid.Row="1" Margin="16,0,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 品牌区 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Grid Width="36" Height="36">
                    <Border CornerRadius="9">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2B8CE8" Offset="0"/>
                                <GradientStop Color="#0F6CBD" Offset="0.55"/>
                                <GradientStop Color="#0A4F8C" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Viewbox Width="20" Height="20">
                        <Grid Width="24" Height="24">
                            <Path Data="M13.4,2.6 L4.8,13.4 H10.8 L9.2,21.4 L19.2,9.8 H13.2 Z"
                                  Fill="White" Stretch="Uniform"/>
                        </Grid>
                    </Viewbox>
                </Grid>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="GitHub520 Hosts" FontSize="19" FontWeight="SemiBold"
                               Foreground="{StaticResource Text}"/>
                    <TextBlock Text="一键修复 GitHub 访问 · 数据源 521xueweihan/GitHub520"
                               FontSize="12" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Column="2" x:Name="Badge" CornerRadius="12" Padding="8,4"
                        Background="#FFFFFF" BorderBrush="{StaticResource Stroke}" BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="BadgeDot" Width="7" Height="7" Fill="#B0B0B0"
                                 Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="BadgeText" Text="检测中" FontSize="12"
                                   Foreground="{StaticResource SubText}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 权限提示条 -->
            <Border Grid.Row="1" x:Name="AlertBar" Visibility="Collapsed"
                    Background="#FFF4CE" BorderBrush="#EFDFA4" BorderThickness="1"
                    CornerRadius="8" Padding="8,5" Margin="0,0,0,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Path Data="M12,3.5 L2.8,19.4 H21.2 Z M12,9.4 V14.2 M12,16.6 V16.9"
                          Stroke="#9D5D00" StrokeThickness="1.7" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" Margin="0,1,7,0"/>
                    <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="#6B4A00"
                               VerticalAlignment="Center"
                               Text="非管理员权限，写入 hosts 与刷新 DNS 会失败。"/>
                    <Button Grid.Column="2" Content="以管理员身份重启" Style="{StaticResource LinkButton}"
                            Foreground="#0F6CBD" FontWeight="SemiBold" Margin="6,0,0,0"
                            VerticalAlignment="Center" Click="OnElevateClick"/>
                </Grid>
            </Border>

            <!-- 状态卡片 -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Height="27" Margin="12,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="hosts 文件" FontSize="12.5" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TxtPath" FontSize="12.5"
                                   Foreground="{StaticResource SubText}"
                                   FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <Border Height="1" Background="{StaticResource Line}" Margin="12,0,12,0"/>
                    <Grid Height="27" Margin="12,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="当前状态" FontSize="12.5" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="StateDot" Width="7" Height="7" Fill="#B0B0B0"
                                     Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtState" FontSize="12.5" Foreground="{StaticResource Muted}"/>
                        </StackPanel>
                    </Grid>
                    <Border Height="1" Background="{StaticResource Line}" Margin="12,0,12,0"/>
                    <Grid Height="27" Margin="12,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="远程数据时间" FontSize="12.5" Foreground="{StaticResource Muted}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TxtTime" FontSize="12.5"
                                   Foreground="{StaticResource SubText}" VerticalAlignment="Center"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 操作区 -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="4" Margin="0,8,0,0">
                <StackPanel>
                    <Button x:Name="BtnUpdate" Style="{StaticResource ActionButton}" Click="OnUpdateClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#2B8CE8" Offset="0"/>
                                        <GradientStop Color="#0F6CBD" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Path Data="M12,3.5 V14 M8,10 L12,14 L16,10 M4.6,16.8 V19.4 H19.4 V16.8"
                                      Stroke="White" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="18" Height="18" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtUpdateTitle" Text="更新 GitHub520 Hosts" FontSize="13.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                <TextBlock Text="拉取最新解析记录并写入 hosts 文件" FontSize="11.5"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Path Grid.Column="2" Data="M9,6 L16,12 L9,18" Stroke="#C0C0C0" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        </Grid>
                    </Button>

                    <Border Height="1" Background="{StaticResource Line}" Margin="8,0"/>

                    <Button x:Name="BtnFlush" Style="{StaticResource ActionButton}" Click="OnFlushClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="#0A000000">
                                <Path Data="M20,12 A8,8 0 1 1 17.6,6.3 M20,4.4 V9.4 H15"
                                      Stroke="#4A4A4A" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="18" Height="18" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtFlushTitle" Text="刷新 DNS 缓存" FontSize="13.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                <TextBlock Text="执行 ipconfig /flushdns 使配置立即生效" FontSize="11.5"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Path Grid.Column="2" Data="M9,6 L16,12 L9,18" Stroke="#C0C0C0" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        </Grid>
                    </Button>

                    <Border Height="1" Background="{StaticResource Line}" Margin="8,0"/>

                    <Button x:Name="BtnReset" Style="{StaticResource ActionButton}" Click="OnResetClick">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="32" Height="32" CornerRadius="8" Background="#0A000000">
                                <Path Data="M9.6,13.6 L5,9 L9.6,4.4 M5,9 H14 A5.6,5.6 0 0 1 14,20.2 H11"
                                      Stroke="#4A4A4A" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="18" Height="18" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtResetTitle" Text="一键清除 GitHub520 条目" FontSize="13.5"
                                           FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                <TextBlock Text="仅移除 GitHub520 段落，其他记录保持不变" FontSize="11.5"
                                           Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Path Grid.Column="2" Data="M9,6 L16,12 L9,18" Stroke="#C0C0C0" StrokeThickness="1.6"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        </Grid>
                    </Button>
                </StackPanel>
            </Border>

            <!-- 日志 -->
            <Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="14,6,10,5">
                        <TextBlock Text="运行日志" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource SubText}" VerticalAlignment="Center"/>
                        <Button Content="清空" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right" Click="OnClearLogClick"/>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                        <ScrollViewer x:Name="LogScroll" VerticalScrollBarVisibility="Auto"
                                      Padding="12,5,10,6">
                            <ItemsControl x:Name="LogList" ItemTemplate="{StaticResource LogTemplate}"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <!-- 页脚 -->
            <Grid Grid.Row="5" Margin="2,6,2,0">
                <TextBlock Text="所有改动前自动备份到 backup\ 目录" FontSize="11.5"
                           Foreground="#9A9A9A"/>
                <TextBlock x:Name="TxtFoot" HorizontalAlignment="Right" FontSize="11.5"
                           Foreground="#9A9A9A"/>
            </Grid>
        </Grid>
    </Grid>
</Window>
